# A structural change since the base model needs a new design record.
exitcode 1 archcheck -code=false -base-model base/model.yaml -base-designs base/designs.txt
stderr 'adds no design record'
stderr '^archcheck: 1 finding$'

# A new record in the same change meets the rule.
cp base/0002-move.md architecture/designs/0002-move.md
exec archcheck -code=false -base-model base/model.yaml -base-designs base/designs.txt
stdout '^archcheck: no findings$'

-- go.mod --
module example.com/m

go 1.27
-- architecture/model.yaml --
version: 1
module: example.com/m
system:
  id: m
  name: M
  description: A system.
people: []
external_systems: []
relationships: []
containers:
  - id: app
    name: App
    technology: Go
    description: The application.
layers:
  - id: core
    directory: internal/core
    description: The core.
    uses: []
    external: []
components: []
test_modules: []
rules:
  - id: no-env
    description: The core reads no environment variable.
    scope:
      layers: [core]
      test_files: false
    forbid_symbols: [os.Getenv]
    fix: Pass the value in.
-- architecture/designs/0001-start.md --
---
design: 1
issue: 1
title: Start
---
-- internal/core/core.go --
package core

// Name returns the name of the core.
func Name() string { return "core" }
-- base/model.yaml --
version: 1
module: example.com/m
system:
  id: m
  name: M
  description: A system.
people: []
external_systems: []
relationships: []
containers:
  - id: app
    name: App
    technology: Go
    description: The application.
layers:
  - id: core
    directory: internal/kernel
    description: The core.
    uses: []
    external: []
components: []
test_modules: []
rules:
  - id: no-env
    description: The core reads no environment variable.
    scope:
      layers: [core]
      test_files: false
    forbid_symbols: [os.Getenv]
    fix: Pass the value in.
-- base/designs.txt --
architecture/designs/0001-start.md
-- base/0002-move.md --
---
design: 2
issue: 1
title: Move the core
---
